# Target FastAPI backend (Render production deployment)
VITE_API_URL=https://blueharvest-api.onrender.com
# For local FastAPI testing: VITE_API_URL=http://localhost:8000
# Add the same Google OAuth Web Client ID to both backend GOOGLE_CLIENT_ID and this value
# only after configuring the Google Console authorized origin for http://localhost:5173.
VITE_GOOGLE_CLIENT_ID=
