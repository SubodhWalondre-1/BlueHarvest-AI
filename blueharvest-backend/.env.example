# Copy to .env for local development. Never commit the real .env file.
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-this-with-a-unique-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Exact frontend origins only; include the scheme and port, without a trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/blueharvest.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=12

# OTP may be returned by the API only in development/test when this is true.
# This avoids fake delivery while allowing local end-to-end testing without provider credentials.
DEV_EXPOSE_OTP=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Rate-limit windows begin with the first request and do not extend on rejection.
LOGIN_WINDOW_SECONDS=300
LOGIN_ACCOUNT_LIMIT=5
LOGIN_IP_LIMIT=30
SIGNUP_WINDOW_SECONDS=3600
SIGNUP_IP_LIMIT=10
OTP_WINDOW_SECONDS=60
OTP_ACCOUNT_LIMIT=10
OTP_IP_LIMIT=30
OTP_REQUEST_IP_LIMIT=10
INFERENCE_WINDOW_SECONDS=60
INFERENCE_ACCOUNT_LIMIT=10
INFERENCE_IP_LIMIT=30
INFERENCE_MAX_CONCURRENT=4
INFERENCE_USER_MAX_CONCURRENT=1
INFERENCE_DAILY_LIMIT=100
UPLOAD_USER_QUOTA_MB=256
INFERENCE_PREVIEW_TTL_HOURS=24

# Email delivery (SMTP). Leave unset until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# SMS delivery (Twilio). Leave unset until configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# For a cross-site HTTPS frontend, set COOKIE_SECURE=true and COOKIE_SAMESITE=none.
# Google OAuth remains disabled until a real Web Client ID and authorized origins are configured.
GOOGLE_CLIENT_ID=

# Demo records can be included in explicitly labelled demo-mode workflows only.
DEMO_MODE_ENABLED=true


# Real BlueHarvest P2PNet inference service on Modal. Keep credentials in backend/.env only.
# The credentials previously shared in chat should be rotated before use.
MODAL_ENABLED=true
MODAL_BASE_URL=https://subodhwalondre87--blueharvest-p2pnet-p2pnetservice-web.modal.run
MODAL_KEY=
MODAL_SECRET=
MODAL_HEALTH_PATH=/health
MODAL_PREDICT_PATH=/predict
MODAL_TIMEOUT_SECONDS=90
# Supported: multipart, base64_json, raw. Default matches the existing frontend image upload contract.
MODAL_REQUEST_FORMAT=multipart
# For multipart, this is the file field name; for base64_json, it is the JSON key.
MODAL_IMAGE_FIELD=image
# Optional: exact count key/path returned by /predict (e.g. count, pred_count, data.count).
# When blank, the backend checks documented common numeric count keys, and rejects responses without one.
MODAL_COUNT_FIELD=
# Optional: dotted path to an array of actual predicted points (e.g. points); only configured explicitly.
MODAL_POINTS_FIELD=
# Permanent image storage (Cloudinary). Leave blank for local disk storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or full URL: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
